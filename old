function normalizeIncomingPayload(msg) {
  const text = msg?.toString?.()?.trim?.() || "";
  if (!text) return null;
  let parsed = JSON.parse(text);
  if (typeof parsed === "string") parsed = JSON.parse(parsed);
  return parsed;
}

function sendWsSafe(ws, payload, { kind = "gps", imei = null } = {}) {
