    if (imei) {
      void persistTraccarDeviceStatus(data).catch(() => {});
      console.warn("Resolved device by id via Traccar", { deviceId, imei, reason });
      return imei;
    }
  } catch (err) {
    console.warn("Traccar device fetch failed", { deviceId, reason, error: err.message });
  }
  return null;
}
