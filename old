function attachLegacyWssClient(ws) {
  legacyWssClientSeq += 1;
  ws._legacyClientId = `ws-${legacyWssClientSeq}`;
  ws._legacyDetachDone = false;
  legacyWssClientCount += 1;
  logSubscriberMonitor("عميل متصل", { client_id: ws._legacyClientId });
}

function detachLegacyWssClient(ws, reason = "close") {
  if (!ws || ws._legacyDetachDone) return;
  ws._legacyDetachDone = true;
  const clientId = ws._legacyClientId || "unknown";
  const imeisBefore = ws.subscriptions ? [...ws.subscriptions] : [];
  removeClientFromAll(ws);
  if (legacyWssClientCount > 0) legacyWssClientCount -= 1;
  logSubscriberMonitor("عميل منفصل", {
    client_id: clientId,
    reason,
    had_imeis: imeisBefore.length,
    imeis: imeisBefore.slice(0, 10),
  });
}

function hasLegacySubscribers() {
  const channelListeners = rooms.get(COMMAND_RESPONSE_CHANNEL)?.size || 0;
  return deviceSubscribers.size > 0 || channelListeners > 0;
}

function hasDeviceSubscribers(imei) {
  const key = imei ? String(imei).trim() : "";
  if (!key) return false;
  const clients = deviceSubscribers.get(key);
  return !!(clients && clients.size > 0);
}

function pruneDeadSubscribersForImei(imei) {
  const clients = deviceSubscribers.get(imei);
  if (!clients) return;
  for (const ws of clients) {
    if (!ws || ws.readyState !== WebSocket.OPEN) clients.delete(ws);
  }
  if (clients.size === 0) deviceSubscribers.delete(imei);
}

function pruneAllDeadSubscribers() {
  for (const imei of [...deviceSubscribers.keys()]) {
    pruneDeadSubscribersForImei(imei);
  }
}

function clearReconnectTimer() {
  if (typeof traccarReconnect !== "undefined" && traccarReconnect.clearTimer) {
    traccarReconnect.clearTimer();
  }
}

function shouldMaintainTraccarIngress() {
  return !RELAY_ONLY_LEGACY || hasLegacySubscribers();
}

async function ensureTraccarIngress(reason = "subscribers_joined") {
  if (!shouldMaintainTraccarIngress()) return;
  if (
    traccarWs &&
    (traccarWs.readyState === WebSocket.OPEN || traccarWs.readyState === WebSocket.CONNECTING)
  ) {
    return;
  }
  if (traccarIngressStarting || (traccarReconnect && traccarReconnect.inProgress)) return;

  traccarIngressStarting = true;
  try {
    if (!traccarHttpClient || !traccarCookieHeader) {
      const { cookieHeader, client } = await loginAndGetCookieHeader();
      traccarHttpClient = client;
      traccarCookieHeader = cookieHeader;
    }
    if (!devicesPollingStarted) startDevicesPolling();
    await fetchTraccarDevicesList(`ingress_${reason}`);
    traccarWs = startWebSocket(traccarCookieHeader);
    console.warn("[legacy-relay] Traccar ingress started", {
      reason,
      subscribed_imeis: deviceSubscribers.size,
      sockets: countDeviceSubscriberSockets(),
    });
  } catch (err) {
    console.warn("[legacy-relay] Traccar ingress start failed", {
      reason,
      error: err.message,
    });
    traccarReconnect.schedule("ingress_start_failed");
  } finally {
    traccarIngressStarting = false;
  }
}

function stopTraccarIngress(reason = "no_subscribers") {
  if (!RELAY_ONLY_LEGACY) return;

  clearReconnectTimer();
  closingForSubscriberIdle = true;
  try {
    if (traccarWs) {
      try {
        traccarWs.close();
      } catch (err) {
        console.warn("[legacy-relay] Traccar WS close error", { error: err.message });
      }
      traccarWs = null;
    }
  } finally {
    closingForSubscriberIdle = false;
  }

  if (devicesPollTimer) {
    clearInterval(devicesPollTimer);
    devicesPollTimer = null;
    devicesPollingStarted = false;
  }

  console.warn("[legacy-relay] Traccar ingress stopped", { reason });
}

function syncSubscriberIngressState(trigger) {
  if (!RELAY_ONLY_LEGACY) return;
  pruneAllDeadSubscribers();
  if (hasLegacySubscribers()) {
    void ensureTraccarIngress(trigger);
  } else {
    stopTraccarIngress(trigger);
  }
}

